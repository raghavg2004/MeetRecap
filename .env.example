# MeetRecap Configuration
PORT=3000
NODE_ENV=development

SESSION_SECRET=your-session-secret-here-change-in-production
JWT_SECRET=your-jwt-secret-here-change-in-production
JWT_EXPIRES_IN=12h

GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

MAX_ROOM_SIZE=12

ENABLE_VOSK_TRANSCRIPTION=true

# Optional cloud transcription for better accuracy
GROQ_API_KEY=
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Longer chunks usually improve transcription accuracy
TRANSCRIPTION_CHUNK_MS=15000

VOSK_MODEL_PATH=vosk-model-small-en-us-0.15

VOSK_HINDI_MODEL_PATH=vosk-model-small-hi-0.22

SUPPORTED_TRANSCRIPTION_LANGUAGES=en,hi

# Enable fallback audio detection (when Vosk transcription fails)
ENABLE_FALLBACK_TRANSCRIPTION=true